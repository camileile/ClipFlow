APP_ENV=development
APP_VERSION=0.10.0
FRONTEND_ORIGIN=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
MAX_DURATION_SECONDS=1800
MAX_FILESIZE_BYTES=786432000
MAX_CONCURRENT_JOBS=3
MAX_JOBS_PER_CLIENT=2
RATE_LIMIT=20
DOWNLOAD_JOB_RATE_LIMIT=5
READY_JOB_TTL=900
FAILED_JOB_TTL=300
LOG_LEVEL=INFO
TRUSTED_PROXY_IPS=
CLIPFLOW_TEMP_DIR=
MAX_URL_LENGTH=2048
MAX_REQUEST_BODY_BYTES=16384
